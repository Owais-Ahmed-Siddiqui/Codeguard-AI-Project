# ══════════════════════════════════════════════════
# CodeGuard AI — Frontend Environment Variables
# Place this file at PROJECT ROOT (same as package.json)
# Copy to .env: cp .env.example .env
# ══════════════════════════════════════════════════

# Backend API URL
# Local dev:
VITE_API_URL=http://localhost:3001
# Production (Render):
# VITE_API_URL=https://your-backend.onrender.com

# Supabase - Get from https://supabase.com/dashboard -> Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Note: Gemini model is set in server/.env as GEMINI_MODEL=gemini-3.5-flash
# Frontend shows "Gemini 3.5 Flash • 20/day free" automatically
